NODE_ENV=development
PORT=4010
DATABASE_URL="mysql://slstore:change_me_dev@127.0.0.1:3308/slstore"
WEB_ORIGIN=http://localhost:5180
GOOGLE_CLIENT_ID=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeAdminPassword123!
STORE_URL=http://localhost:5180
# Configure an authenticated transactional SMTP service before sending real orders.
# 587: STARTTLS. 465: TLS from the start. Avoid placing secrets in GitHub.
# Gmail/Google Workspace example: smtp.gmail.com with a provider-approved app password.
# STORE_URL must be your public HTTPS storefront URL in production; it is used in email links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Verified sender address; should match/align with the SMTP account and provider domain.
SMTP_FROM=
# Optional inbox for new order notifications.
ORDER_ALERT_EMAIL=
# Optional inbox override for the public Contact form; falls back to ORDER_ALERT_EMAIL then store contactEmail.
CONTACT_ALERT_EMAIL=
# TRUST_PROXY=true only behind one trusted HTTPS reverse proxy.
TRUST_PROXY=false
