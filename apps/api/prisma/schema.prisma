generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ProductEventType {
  CLICK
  VIEW
  CART_ADD
  WISHLIST_ADD
  CHECKOUT_START
}

model User {
  id           String      @id @default(cuid()) @db.VarChar(64)
  email        String      @unique @db.VarChar(191)
  name         String      @db.VarChar(120)
  phone        String?     @db.VarChar(30)
  passwordHash String?     @db.VarChar(255)
  googleSub    String?     @unique @db.VarChar(191)
  role         Role        @default(CUSTOMER)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  sessions     Session[]
  passwordResets PasswordResetToken[]
  addresses    Address[]
  cart         CartItem[]
  wishlist     WishlistItem[]
  orders       Order[]
  productEvents ProductEvent[]
}

model Session {
  id        String   @id @default(cuid()) @db.VarChar(64)
  userId    String @db.VarChar(64)
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid()) @db.VarChar(64)
  userId    String @db.VarChar(64)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Address {
  id        String   @id @default(cuid()) @db.VarChar(64)
  userId    String @db.VarChar(64)
  fullName  String   @db.VarChar(120)
  phone     String   @db.VarChar(30)
  line1     String   @db.VarChar(191)
  line2     String?  @db.VarChar(191)
  city      String   @db.VarChar(100)
  district  String   @db.VarChar(60)
  postal    String?  @db.VarChar(20)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Category {
  id        String    @id @default(cuid()) @db.VarChar(64)
  name      String    @db.VarChar(100)
  slug      String    @unique @db.VarChar(120)
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id             String        @id @default(cuid()) @db.VarChar(64)
  title          String        @db.VarChar(191)
  slug           String        @unique @db.VarChar(191)
  description    String        @db.Text
  imageUrl       String?       @db.VarChar(500)
  images         Json?
  specifications Json?
  shortDescription String?     @db.VarChar(320)
  sku            String?       @unique @db.VarChar(80)
  priceCents     Int
  compareAtCents Int?
  stock          Int           @default(0)
  featured       Boolean       @default(false)
  status         ProductStatus @default(DRAFT)
  categoryId     String @db.VarChar(64)
  category       Category      @relation(fields: [categoryId], references: [id])
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  productEvents ProductEvent[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  @@index([status, createdAt])
  @@index([categoryId])
}

model CartItem {
  id        String   @id @default(cuid()) @db.VarChar(64)
  userId    String @db.VarChar(64)
  productId String @db.VarChar(64)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([userId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid()) @db.VarChar(64)
  userId    String @db.VarChar(64)
  productId String @db.VarChar(64)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([userId, productId])
}

model Order {
  id             String        @id @default(cuid()) @db.VarChar(64)
  number         String        @unique @db.VarChar(40)
  checkoutKey    String        @unique @db.VarChar(100)
  userId         String @db.VarChar(64)
  user           User          @relation(fields: [userId], references: [id])
  status         OrderStatus   @default(PLACED)
  paymentMethod  String        @default("COD") @db.VarChar(20)
  paymentStatus  PaymentStatus @default(PENDING)
  subtotalCents  Int
  shippingCents  Int
  totalCents     Int
  address        Json
  courierName    String?       @db.VarChar(120)
  trackingNumber String?       @db.VarChar(120)
  trackingUrl    String?       @db.VarChar(500)
  estimatedDeliveryAt DateTime?
  statusEvents   OrderStatusEvent[]
  note           String?       @db.VarChar(500)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  items          OrderItem[]
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderStatusEvent {
  id          String      @id @default(cuid()) @db.VarChar(64)
  orderId     String      @db.VarChar(64)
  status      OrderStatus
  createdAt   DateTime    @default(now())
  createdBy   String?     @db.VarChar(120)
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId, createdAt])
}

model OrderItem {
  id             String @id @default(cuid()) @db.VarChar(64)
  orderId        String @db.VarChar(64)
  productId      String @db.VarChar(64)
  title          String @db.VarChar(191)
  imageUrl       String? @db.VarChar(500)
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}


/** First-party behaviour events for 90-day store analytics; never stores IP or UA. */
model ProductEvent {
  id        String           @id @default(cuid()) @db.VarChar(64)
  productId String           @db.VarChar(64)
  userId    String?          @db.VarChar(64)
  visitorId String?          @db.VarChar(36)
  type      ProductEventType
  dedupeKey String?          @unique @db.Char(64)
  createdAt DateTime         @default(now())
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([productId, createdAt])
  @@index([createdAt])
  @@index([type, createdAt])
  @@index([userId, productId, createdAt])
  @@index([visitorId, createdAt])
}

model StoreSettings {
  id                    String @id @default("main") @db.VarChar(64)
  storeName             String @default("SL Options Market") @db.VarChar(120)
  announcement          String @default("Islandwide delivery across Sri Lanka") @db.VarChar(200)
  contactEmail          String @default("hello@sloptions.xyz") @db.VarChar(191)
  shippingFlatCents     Int    @default(45000)
  freeShippingFromCents Int    @default(1500000)
}
